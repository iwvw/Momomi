<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <!--  托盘图标 + Fluent 右键菜单（SecondWindow 模式：在独立 WinUI 窗口渲染原生 MenuFlyout）。
          点击处理在 TrayIconService 里按名称挂接，避免在 XAML 里写事件。
          初始 Collapsed，由 TrayIconService.Show 决定是否显示，避免启动瞬间闪现。  -->
    <tb:TaskbarIcon
        x:Key="MomomiTrayIcon"
        IconSource="ms-appx:///Assets/TrayDefault.ico"
        NoLeftClickDelay="True"
        ToolTipText="Momomi"
        Visibility="Collapsed">
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                <!-- 内核状态（只读，图标与颜色由 TrayIconService 按状态更新） -->
                <MenuFlyoutItem x:Name="TrayStatusItem" FontSize="13" IsEnabled="False" Text="内核：未知">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="12" Glyph="&#xEA3B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutItem x:Name="TrayOpenItem" FontSize="13" Text="打开主界面">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="TrayMiniItem" FontSize="13" Text="显示迷你面板">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE90B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutSubItem x:Name="TrayCoreMenu" FontSize="13" Text="内核">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem x:Name="TrayStartCoreItem" FontSize="13" Text="启动内核">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="TrayStopCoreItem" FontSize="13" Text="停止内核">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="TrayRestartCoreItem" FontSize="13" Text="重启内核">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>

                <MenuFlyoutSubItem x:Name="TrayModeMenu" FontSize="13" Text="代理模式">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                    </MenuFlyoutSubItem.Icon>
                    <ToggleMenuFlyoutItem x:Name="TrayModeRuleItem" FontSize="13" Text="规则模式">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="TrayModeGlobalItem" FontSize="13" Text="全局模式">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE774;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="TrayModeDirectItem" FontSize="13" Text="直连模式">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                </MenuFlyoutSubItem>

                <MenuFlyoutSeparator />

                <ToggleMenuFlyoutItem x:Name="TraySystemProxyItem" FontSize="13" Text="系统代理">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE774;" />
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="TrayTunItem" FontSize="13" Text="TUN 模式">
                    <ToggleMenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE968;" />
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>

                <MenuFlyoutSeparator />

                <MenuFlyoutItem x:Name="TrayExitItem" FontSize="13" Text="退出">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
