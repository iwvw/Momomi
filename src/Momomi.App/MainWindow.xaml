<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Momomi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Momomi.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Momomi"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title=""
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Image Width="24" Height="24" VerticalAlignment="Center"
                           Source="ms-appx:///Assets/AppIcon.png" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Text="Momomi" />
                    <Border VerticalAlignment="Center"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="AppVersionText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="v-" />
                    </Border>

                    <!-- 可更新胶囊：仅在有新版本时显示。
                         TitleBar 整体是拖拽区，交互控件必须标 IsDragRegion="False"，
                         否则点击会被当成拖窗口。

                         外观用「单 visual」的做法：Button 自身透明无边框，圆角背景由内部
                         一个 Grid 承载。原因见 App.xaml 的 CardStyle 注释——Border 同时带
                         Background + BorderThickness + CornerRadius 时会被拆成两个 visual，
                         圆角处出现接缝/锯齿（microsoft-ui-xaml#9454）。

                         另外不要用 IsEnabled=false 表示「正在下载」：禁用态会由模板覆盖
                         Background 与文字色，胶囊会变成灰底暗字（看起来就像样式坏了）。
                         重复点击用代码里的 _updateInFlight 拦截，文案改为进度即可。 -->
                    <Button x:Name="UpdatePill"
                            TitleBar.IsDragRegion="False"
                            VerticalAlignment="Center"
                            Padding="0"
                            MinHeight="0"
                            MinWidth="0"
                            Height="22"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="UpdatePill_Click"
                            ToolTipService.ToolTip="发现新版本，点击更新">
                        <Grid Height="22" CornerRadius="11"
                              Padding="9,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <!-- 前景色写死白色：胶囊底色恒为 AccentFillColorDefaultBrush，
                                     TextOnAccentFillColorPrimaryBrush 在部分主题组合下会解析成黑色，
                                     深色底 + 黑字完全看不清。白字在浅/深两种 accent 上都可读。 -->
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="White" />
                                <TextBlock x:Name="UpdatePillText"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="White"
                                           Text="可更新" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontSize="14" VerticalAlignment="Center" Glyph="&#xE774;" />
                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="代理" />
                        <ToggleSwitch x:Name="SystemProxySwitch"
                                      MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ModeSelector.SystemProxyOn, Mode=OneWay}"
                                      Toggled="SystemProxy_Toggled"
                                      ToolTipService.ToolTip="系统代理" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontSize="14" VerticalAlignment="Center" Glyph="&#xE701;" />
                        <TextBlock FontSize="14" VerticalAlignment="Center" Text="TUN" />
                        <ToggleSwitch x:Name="TunSwitch"
                                      MinWidth="0"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ModeSelector.TunOn, Mode=OneWay}"
                                      Toggled="Tun_Toggled"
                                      ToolTipService.ToolTip="TUN 模式（需要管理员权限，切换会重启内核）" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <toolkit:Segmented x:Name="ModeSegmented"
                                           MinHeight="0"
                                           VerticalAlignment="Center"
                                           SelectedIndex="{x:Bind ModeSelector.SelectedIndex, Mode=OneWay}"
                                           SelectionChanged="ModeSegmented_SelectionChanged">
                            <toolkit:SegmentedItem Content="规则" ToolTipService.ToolTip="规则模式：按配置规则分流" />
                            <toolkit:SegmentedItem Content="全局" ToolTipService.ToolTip="全局模式：所有流量走代理" />
                            <toolkit:SegmentedItem Content="直连" ToolTipService.ToolTip="直连模式：所有流量不经过代理" />
                        </toolkit:Segmented>
                    </StackPanel>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            OpenPaneLength="200"
            PaneOpened="NavView_PaneChanged"
            PaneClosed="NavView_PaneChanged"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" IsSelected="True" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="代理" Tag="proxies">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="订阅" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="覆写" Tag="overrides">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="连接" Tag="connections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="规则" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="流量" Tag="traffic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="网络" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="NavFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <controls:PaneSplitter x:Name="PaneSplitter"
                               Grid.Row="1"
                               Width="6"
                               Margin="200,0,0,0"
                               HorizontalAlignment="Left"
                               Background="Transparent"
                               DragStarted="PaneSplitter_DragStarted"
                               Dragged="PaneSplitter_Dragged"
                               DragCompleted="PaneSplitter_DragCompleted" />
    </Grid>
</Window>
