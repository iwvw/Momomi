<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Momomi</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Momomi.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- 默认自包含（合并版）。分离版由 CI 传 -p:WindowsAppSDKSelfContained=false 覆盖。 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 只保留中文与英文的卫星资源程序集，去掉其余 80 多个语言目录（约省 11 MB）。
         应用界面只有中文，英文作为回退。 -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayDefault.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayGreen.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TrayRed.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\FlagsEmoji.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\flags\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <!-- 进程图标提取需要 System.Drawing；用 NuGet 包替代 WindowsDesktop.App.WindowsForms 框架引用，
         避免为取一个图标把整个 WinForms 运行时（约 24 MB）打进发布目录。 -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Momomi.Core\Momomi.Core.csproj" />
    <ProjectReference Include="..\Momomi.Elevated\Momomi.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 将提权宿主可执行文件复制到主程序输出目录，供 TUN 提权时调用。 -->
  <!-- 路径必须带 $(Platform)：构建时指定 -p:Platform=x64，输出在 bin\x64\Debug 而非 bin\Debug。 -->
  <Target Name="CopyElevatedHost" AfterTargets="Build">
    <PropertyGroup>
      <ElevatedHostOutDir>$(MSBuildThisFileDirectory)..\Momomi.Elevated\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</ElevatedHostOutDir>
      <ElevatedHostOutDirFallback>$(MSBuildThisFileDirectory)..\Momomi.Elevated\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</ElevatedHostOutDirFallback>
    </PropertyGroup>
    <ItemGroup>
      <ElevatedHostFile Include="$(ElevatedHostOutDir)\Momomi.Elevated.exe" Condition="Exists('$(ElevatedHostOutDir)\Momomi.Elevated.exe')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDirFallback)\Momomi.Elevated.exe" Condition="!Exists('$(ElevatedHostOutDir)\Momomi.Elevated.exe') AND Exists('$(ElevatedHostOutDirFallback)\Momomi.Elevated.exe')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDir)\Momomi.Elevated.dll" Condition="Exists('$(ElevatedHostOutDir)\Momomi.Elevated.dll')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDirFallback)\Momomi.Elevated.dll" Condition="!Exists('$(ElevatedHostOutDir)\Momomi.Elevated.dll') AND Exists('$(ElevatedHostOutDirFallback)\Momomi.Elevated.dll')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDir)\Momomi.Elevated.deps.json" Condition="Exists('$(ElevatedHostOutDir)\Momomi.Elevated.deps.json')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDirFallback)\Momomi.Elevated.deps.json" Condition="!Exists('$(ElevatedHostOutDir)\Momomi.Elevated.deps.json') AND Exists('$(ElevatedHostOutDirFallback)\Momomi.Elevated.deps.json')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDir)\Momomi.Elevated.runtimeconfig.json" Condition="Exists('$(ElevatedHostOutDir)\Momomi.Elevated.runtimeconfig.json')" />
      <ElevatedHostFile Include="$(ElevatedHostOutDirFallback)\Momomi.Elevated.runtimeconfig.json" Condition="!Exists('$(ElevatedHostOutDir)\Momomi.Elevated.runtimeconfig.json') AND Exists('$(ElevatedHostOutDirFallback)\Momomi.Elevated.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedHostFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!-- WinUI 3 的 XAML 依赖运行时反射，PublishTrimmed=true 会裁掉绑定所需类型，
         导致启动时 XamlParseException（ItemsRepeater.ItemsSource 绑定失败）。
         因此必须关闭 trimming，改用下方 RemoveUnusedRuntimeDlls 精简体积。 -->
    <!-- ReadyToRun 会把程序集预编译进本机代码，包体增加约 49 MB（216→265）。
         本应用常驻、启动一次即可，权衡后默认关闭。 -->
    <PublishTrimmed>False</PublishTrimmed>
    <PublishReadyToRun>False</PublishReadyToRun>
  </PropertyGroup>

  <!-- 发布后删除本项目运行期完全不使用的运行时组件：Windows ML(onnx/DirectML)、
       Windows AI/语义搜索/内容安全、搜索、小组件、Workloads、WebView2、
       调试器与转储、WinForms 残留、多余语言目录等。内核与 geodata 不在此列，
       由应用首启时按需下载。 -->
  <Target Name="RemoveUnusedRuntimeDlls" AfterTargets="Publish">
    <!-- 按文件名通配删除；Delete 的 Files 支持通配符，目标不存在时静默跳过。 -->
    <ItemGroup>
      <!-- 调试器 / 崩溃转储 / 重启代理：正常使用不需要。 -->
      <UnusedRuntimeDll Include="$(PublishDir)mscordaccore*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)mscordbi.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)createdump.exe" />
      <UnusedRuntimeDll Include="$(PublishDir)RestartAgent.exe" />
      <!-- 编译器/符号辅助。 -->
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
      <!-- Windows ML / AI / 语义搜索 / 内容安全。 -->
      <UnusedRuntimeDll Include="$(PublishDir)onnxruntime.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)DirectML.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)NPUDetect.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Search.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Search.Projection.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Search.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Widgets.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Widgets.Projection.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Widgets.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.AI*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.AI*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Internal.AI*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Vision*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Vision*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Internal.Vision*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.SemanticSearch*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.SemanticSearch*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.ImageCreationInternal*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Internal.ImageCreation*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.ContentModeration*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.AI.ContentModeration*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Graphics.ImagingInternal*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)PerceptiveStreaming.dll" />
      <!-- Workloads（Copilot+ PC 本地模型运行时）。 -->
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Workloads*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Workloads*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Workloads.pri" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Windows.Private.Workloads*.winmd" />
      <UnusedRuntimeDll Include="$(PublishDir)workloads.*.json" />
      <!-- WebView2（本应用不使用）。 -->
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.Web.WebView2*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)WebView2Loader.dll" />
      <!-- WinForms / VB 残留（托盘已改用 H.NotifyIcon）。 -->
      <UnusedRuntimeDll Include="$(PublishDir)System.Windows.Forms*.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)System.Windows.Forms.Design.dll" />
      <UnusedRuntimeDll Include="$(PublishDir)Microsoft.VisualBasic*.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedRuntimeDll)" ContinueOnError="true" />

    <!-- WinForms / VB 卫星资源程序集（各语言目录下的 .resources.dll）。 -->
    <ItemGroup>
      <UnusedFormsResources Include="$(PublishDir)**\System.Windows.Forms*.resources.dll" />
      <UnusedFormsResources Include="$(PublishDir)**\Microsoft.VisualBasic*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedFormsResources)" ContinueOnError="true" />

    <!-- 语言目录只保留中英文：删除其余语言的 .mui 与残留空目录（约省 15 MB）。
         MSBuild 通配对目录名条件支持不佳，改用内联 PowerShell 精确清理。 -->
    <Exec Command="powershell -NoProfile -Command &quot;$keep=@('zh-CN','zh-Hans','zh-Hant','en','en-us','en-US','en-GB'); Get-ChildItem -LiteralPath '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Za-z]+)?$' -and $keep -notcontains $_.Name } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" ContinueOnError="true" />

    <Message Importance="high" Text="已移除未使用的运行时组件（ML/AI/搜索/小组件/Workloads/WebView2/调试器/WinForms/卫星资源/多余语言目录）。" />
  </Target>
</Project>
