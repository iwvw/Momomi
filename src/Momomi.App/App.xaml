<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Momomi.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Momomi.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///TrayMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:StateToBrushConverter x:Key="StateToBrush" />
            <converters:DelayToBrushConverter x:Key="DelayToBrush" />
            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <converters:SelectedToBrushConverter x:Key="SelectedToBrush" />
            <converters:SelectedBorderBrushConverter x:Key="SelectedBorderBrush" />
            <converters:SvgImageSourceConverter x:Key="SvgImageSource" />

            <!-- 页面内容最大宽度：对齐 Windows 设置的限宽居中范式 -->
            <x:Double x:Key="PageContentMaxWidth">1064</x:Double>

            <!-- 标题栏右侧预留少量拖拽区，让顶栏控件与窗口按钮之间留约 4px 间距 -->
            <x:Double x:Key="TitleBarMinDragRegionWidth">4</x:Double>

            <!-- 内容区透出 Mica 背景：覆盖 NavigationView 默认的半透明灰层（LayerFillColorDefaultBrush） -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

            <!-- 去掉导航页内的分隔线：导航栏与内容区之间的竖线、内容区顶部横线 -->
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <!-- 卡片容器用 Grid 而非 Border：Border 同时设置 CornerRadius + BorderThickness + Background
                 时背景与描边会被拆成两个 visual，圆角处出现接缝（microsoft-ui-xaml#9454）。
                 Grid 为单一 visual，圆角平滑；官方 Gallery 与 SettingsCard 亦用 Grid 承载卡片。 -->
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- 页面根容器：透明以透出 Mica 背景 -->
            <Style x:Key="PageRootStyle" TargetType="Page">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style x:Key="RateUpBrush" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="RateDownBrush" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>

            <Style x:Key="TagChipStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MaxWidth" Value="320" />
            </Style>

            <!-- 节点名称字体：优先用 FlagsEmoji 提供国旗字形（Windows 从 Win10 起移除了 Segoe UI Emoji 的国旗连字，
                 🇺🇸 会退化成 US 两个字母），其余字形（拉丁/中文/普通 emoji）回退到系统字体 -->
            <FontFamily x:Key="NodeNameFontFamily">ms-appx:///Assets/FlagsEmoji.ttf#Twemoji Mozilla, Segoe UI, Microsoft YaHei UI, Segoe UI Emoji</FontFamily>

            <!-- 节点按钮：直接用原生 Button 模板（hover/按下填充由系统负责），
                 自身无边框，描边由外层 Border 提供，避免 hover 时覆盖。 -->
            <Style x:Key="NodeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- 延迟文本即测速按钮：无边框、紧凑，点击只测该节点 -->
            <Style x:Key="DelayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 仅图标功能按钮：ghost 正方形，悬停有淡色底（与代理组展开按钮一致） -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>

            <!-- 工具栏按钮：ghost 文字/图标按钮，统一 32 高与圆角，悬停有淡色底 -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>

            <!-- 工具栏开关：与 ToolbarButtonStyle 外观一致；选中态用淡色底而非强调色填充，避免抢视觉 -->
            <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>

            <!-- 危险操作按钮：破坏性动作（如全部关闭）用系统警示色前景，弱化填充降低误触 -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>

            <!-- 卡片头部整行可点击：铺满卡片宽度，内边距与卡片正文一致以保证左对齐，悬停有淡色底 -->
            <Style x:Key="CardHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8,8,0,0" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- 首页导航卡片：整卡可点击跳转，卡片外观 + hover/pressed 轻反馈 -->
            <Style x:Key="DashboardCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
