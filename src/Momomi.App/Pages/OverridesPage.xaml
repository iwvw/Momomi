<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Momomi.App.Pages.OverridesPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Momomi.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Momomi.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0"
                          Title="覆写"
                          Subtitle="{x:Bind ViewModel.StatusText, Mode=OneWay}">
            <local:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ImportUrlBox" Width="240" VerticalAlignment="Center"
                             PlaceholderText="粘贴覆写文件链接"
                             KeyDown="ImportUrlBox_KeyDown" />
                    <Button VerticalAlignment="Center" Click="ImportUrl_Click" Content="从链接导入" />
                    <Button VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ImportFileCommand}" Content="从文件导入" />
                    <Button VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="New_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock Text="新建" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="TemplateFlyout" Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </local:PageHeader.Actions>
        </local:PageHeader>

        <!-- 说明条：讲清覆写的语义，避免用户以为是"整份替换" -->
        <InfoBar Grid.Row="1" MaxWidth="1064" Margin="36,0,36,0"
                 IsOpen="True" IsClosable="False"
                 Severity="Informational"
                 Title="覆写会叠加在订阅之上，订阅刷新后依然生效"
                 Message="+rules 插到规则最前面，rules+ 追加到末尾，key! 整体替换该字段。多个覆写按「全局启用 → 当前订阅挂载」的顺序叠加，后者优先。" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="36,0,36,0">
            <Border>
                <GridView ItemsSource="{x:Bind ViewModel.Items}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          MaxWidth="{StaticResource PageContentMaxWidth}"
                          Padding="0,0,0,24">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="300" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OverrideRowViewModel">
                            <Grid Style="{StaticResource CardStyle}"
                                  MinHeight="132"
                                  Padding="16,14"
                                  Tag="{x:Bind}"
                                  DoubleTapped="Card_DoubleTapped">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <FontIcon FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Glyph="&#xE70F;" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind Name}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                            Width="28" Height="28"
                                            ToolTipService.ToolTip="更多">
                                        <FontIcon FontSize="12" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="编辑"
                                                                Tag="{x:Bind}"
                                                                Click="Edit_Click" />
                                                <MenuFlyoutItem Text="重命名"
                                                                Tag="{x:Bind}"
                                                                Click="Rename_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="删除"
                                                                Tag="{x:Bind}"
                                                                Click="Delete_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10" Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind SourceText}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind UpdatedText, Mode=OneTime}" />
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="全局启用" />
                                    <ToggleSwitch Grid.Column="1"
                                                  MinWidth="0"
                                                  OnContent="" OffContent=""
                                                  IsOn="{x:Bind IsGlobal, Mode=OneWay}"
                                                  Toggled="Global_Toggled"
                                                  ToolTipService.ToolTip="全局启用后对所有订阅生效" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>
        </ScrollViewer>

        <!-- 编辑大弹窗：语法错误就地提示，可切到合并预览 -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="EditorPanel"
                    Margin="40"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="最大化/还原"
                                Click="ToggleEditorMaximize_Click">
                            <FontIcon x:Name="EditorMaximizeIcon" FontSize="12" Glyph="&#xE740;" />
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="关闭"
                                Command="{x:Bind ViewModel.CloseEditorCommand}">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <SelectorBar x:Name="EditorTabs" Grid.Row="1" Margin="0,0,0,12"
                                 SelectionChanged="EditorTabs_SelectionChanged">
                        <SelectorBarItem Text="覆写内容" IsSelected="True" />
                        <SelectorBarItem Text="合并预览" />
                    </SelectorBar>

                    <InfoBar Grid.Row="2" Margin="0,0,0,8"
                             IsOpen="{x:Bind ViewModel.HasEditorError, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Error"
                             Title="覆写内容有误"
                             Message="{x:Bind ViewModel.EditorError, Mode=OneWay}" />

                    <Grid Grid.Row="3">
                        <local:CodeEditor x:Name="RawEditor"
                                             Visibility="{x:Bind ViewModel.IsRawTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Grid x:Name="PreviewPanel"
                              Visibility="{x:Bind ViewModel.IsPreviewTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 摘要条：改动统计 + 视图模式 + 基线提示 -->
                            <Grid Grid.Row="0" ColumnSpacing="12" Padding="12,6" Margin="0,0,0,6"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.DiffSummary, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.OtherOverridesHint, Mode=OneWay}"
                                           Text="{x:Bind ViewModel.OtherOverridesHint, Mode=OneWay}" />
                                <ToggleSwitch Grid.Column="2"
                                              MinWidth="0"
                                              OnContent="仅改动"
                                              OffContent="全文"
                                              IsOn="{x:Bind ViewModel.ChangesOnly, Mode=TwoWay}"
                                              ToolTipService.ToolTip="只显示改动行及其上下文" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DiffLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiffLineViewModel">
                                            <Grid ColumnSpacing="8" Padding="4,0,12,0" MinHeight="18"
                                                  Background="{x:Bind RowBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Text="{x:Bind LineNumber}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{x:Bind GlyphBrush}"
                                                           Text="{x:Bind Glyph}" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Consolas" FontSize="12"
                                                           TextWrapping="NoWrap"
                                                           Text="{x:Bind Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <ProgressRing Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsPreviewBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsPreviewBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Click="SaveEditor_Click"
                                Content="保存" />
                        <Button Command="{x:Bind ViewModel.CloseEditorCommand}"
                                Content="关闭" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
