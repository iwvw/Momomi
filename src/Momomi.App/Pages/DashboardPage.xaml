<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Momomi.App.Pages.DashboardPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Momomi.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Momomi.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <controls:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0" Title="概览">
            <controls:PageHeader.SubtitleContent>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{x:Bind ViewModel.StateKey, Mode=OneWay, Converter={StaticResource StateToBrush}}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CoreStateText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CoreVersion, Mode=OneWay}" />
                </StackPanel>
            </controls:PageHeader.SubtitleContent>
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="刷新" />
                    <Button Command="{x:Bind ViewModel.RestartCoreCommand}" Content="重启内核" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleCoreCommand}"
                            Content="{x:Bind ViewModel.ToggleText, Mode=OneWay}" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="36,0,36,0">
            <Border>
                <StackPanel Spacing="12" Padding="0,0,0,24" MaxWidth="{StaticResource PageContentMaxWidth}">

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Title="内核提示"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />


                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         IsClosable="False"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         Severity="Error"
                         Title="内核异常" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE898;"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="上传" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.UpRate, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.UpTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE896;"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="下载" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.DownRate, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.DownTotal, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE950;" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存占用" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Memory, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内核占用" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="3" Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Glyph="&#xE704;" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="活动连接" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                       Text="{x:Bind ViewModel.ConnectionCount, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind ViewModel.NodeCountText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="实时速率" />
                            <controls:SparklineChart Height="96"
                                                     Values="{x:Bind ViewModel.DownPoints, Mode=OneWay}"
                                                     Maximum="{x:Bind ViewModel.MaxRate, Mode=OneWay}">
                                <controls:SparklineChart.Stroke>
                                    <SolidColorBrush Color="#22C55E" />
                                </controls:SparklineChart.Stroke>
                                <controls:SparklineChart.Fill>
                                    <SolidColorBrush Color="#2022C55E" />
                                </controls:SparklineChart.Fill>
                            </controls:SparklineChart>
                            <controls:SparklineChart Height="64"
                                                     Values="{x:Bind ViewModel.UpPoints, Mode=OneWay}"
                                                     Maximum="{x:Bind ViewModel.MaxRate, Mode=OneWay}">
                                <controls:SparklineChart.Stroke>
                                    <SolidColorBrush Color="#F59E0B" />
                                </controls:SparklineChart.Stroke>
                                <controls:SparklineChart.Fill>
                                    <SolidColorBrush Color="#20F59E0B" />
                                </controls:SparklineChart.Fill>
                            </controls:SparklineChart>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Text="{x:Bind ViewModel.DownRate, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind ViewModel.UpRate, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Grid Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        ToolTipService.ToolTip="前往订阅"
                                        Click="GoProfiles_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontSize="13" VerticalAlignment="Center" Glyph="&#xE8B7;" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="当前订阅" />
                                        <FontIcon Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" Padding="16,0,16,14">
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind ViewModel.ProfileUsageText, Mode=OneWay}" />
                                    <ProgressBar Maximum="100"
                                                 Value="{x:Bind ViewModel.ProfileUsagePercent, Mode=OneWay}"
                                                 Height="4"
                                                 Visibility="{x:Bind ViewModel.HasProfileUsage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind ViewModel.ProfileExpireText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        ToolTipService.ToolTip="前往设置"
                                        Click="GoSettings_Click">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontSize="13" VerticalAlignment="Center" Glyph="&#xE713;" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="运行状态" />
                                        <FontIcon Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" Padding="16,0,16,14">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行模式  " />
                                        <Run Text="{x:Bind ViewModel.Mode, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="混合端口  " />
                                        <Run Text="{x:Bind ViewModel.MixedPort, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统代理  " />
                                        <Run Text="{x:Bind ViewModel.SystemProxyText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Button Style="{StaticResource CardHeaderButtonStyle}"
                                ToolTipService.ToolTip="前往代理"
                                Click="GoProxies_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontSize="13" VerticalAlignment="Center" Glyph="&#xE968;" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" Text="代理组" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind ViewModel.GroupSummary, Mode=OneWay}" />
                                <FontIcon Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE76C;" />
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}"
                                       Margin="16,0,16,14">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="320"
                                                   MinItemHeight="56"
                                                   MinColumnSpacing="24"
                                                   MinRowSpacing="2"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardGroupViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock FontFamily="{StaticResource NodeNameFontFamily}"
                                                       TextTrimming="CharacterEllipsis" Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontFamily="{StaticResource NodeNameFontFamily}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{x:Bind SelectedNode}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
