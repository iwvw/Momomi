<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Momomi.App.Pages.ConnectionsPage"
    NavigationCacheMode="Required"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Momomi.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Momomi.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0" Title="连接">
            <controls:PageHeader.SubtitleContent>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                </StackPanel>
            </controls:PageHeader.SubtitleContent>
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" VerticalAlignment="Center"
                             PlaceholderText="过滤域名 / 进程 / IP"
                             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox x:Name="SortBox" VerticalAlignment="Center" Width="120" Height="32"
                              SelectionChanged="Sort_SelectionChanged"
                              ToolTipService.ToolTip="排序字段">
                        <ComboBoxItem Content="按时长" />
                        <ComboBoxItem Content="按上传" />
                        <ComboBoxItem Content="按下载" />
                        <ComboBoxItem Content="按进程" />
                        <ComboBoxItem Content="按域名" />
                    </ComboBox>

                    <Button VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                            Click="SortDirection_Click"
                            ToolTipService.ToolTip="升序 / 降序">
                        <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
                    </Button>

                    <ToggleButton x:Name="RealtimeButton" VerticalAlignment="Center"
                                  Height="32" MinWidth="0" Padding="12,0"
                                  Click="Realtime_Click"
                                  ToolTipService.ToolTip="实时刷新，暂停后冻结列表">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.RealtimeGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.RealtimeText, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>

                    <Button VerticalAlignment="Center" Height="32" MinWidth="0" Padding="12,0"
                            Command="{x:Bind ViewModel.CloseAllCommand}"
                            Content="全部关闭" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="36,0,36,0">
            <Border>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}" Margin="0,0,0,24" MaxWidth="{StaticResource PageContentMaxWidth}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                        <Grid Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="36" Height="36"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Source="{x:Bind Icon}"
                                   Visibility="{x:Bind HasIcon, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Process}" />
                                    <Run Text=" → " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind Host}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid Style="{StaticResource TagChipStyle}">
                                        <TextBlock Text="{x:Bind Network}" />
                                    </Grid>
                                    <Grid Style="{StaticResource TagChipStyle}"
                                            Visibility="{x:Bind HasChain, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Chain}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid Style="{StaticResource TagChipStyle}"
                                            Visibility="{x:Bind HasRule, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Rule}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2" MinWidth="72" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Upload}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind UpRate, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="2" MinWidth="72" Margin="12,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Download}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Text="{x:Bind DownRate, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Spacing="2" MinWidth="56" Margin="12,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="时长" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Duration}" />
                            </StackPanel>

                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                    Width="28" Height="28" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="关闭此连接"
                                    Command="{Binding DataContext.CloseConnectionCommand, ElementName=PageRoot}"
                                    CommandParameter="{x:Bind}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
