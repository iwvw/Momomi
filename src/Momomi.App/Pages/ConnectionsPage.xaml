<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Momomi.App.Pages.ConnectionsPage"
    NavigationCacheMode="Required"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Momomi.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Momomi.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0" Title="连接">
            <controls:PageHeader.SubtitleContent>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                </StackPanel>
            </controls:PageHeader.SubtitleContent>
        </controls:PageHeader>

        <!-- 工具栏单独一行，避免过多控件挤压副标题 -->
        <Grid Grid.Row="1" MaxWidth="1064" Margin="36,0,36,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" VerticalAlignment="Center"
                     PlaceholderText="过滤域名 / 进程 / IP"
                     Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox x:Name="SortBox" Grid.Column="1" VerticalAlignment="Center" Width="120" Height="32"
                      SelectionChanged="Sort_SelectionChanged"
                      ToolTipService.ToolTip="排序字段">
                <ComboBoxItem Content="按时长" />
                <ComboBoxItem Content="按上传" />
                <ComboBoxItem Content="按下载" />
                <ComboBoxItem Content="按进程" />
                <ComboBoxItem Content="按域名" />
            </ComboBox>

            <Button Grid.Column="2" VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                    Click="SortDirection_Click"
                    ToolTipService.ToolTip="升序 / 降序">
                <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
            </Button>

            <ToggleButton x:Name="RealtimeButton" Grid.Column="3" VerticalAlignment="Center"
                          Height="32" MinWidth="0" Padding="12,0"
                          Click="Realtime_Click"
                          ToolTipService.ToolTip="实时刷新，暂停后冻结列表">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.RealtimeGlyph, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.RealtimeText, Mode=OneWay}" />
                </StackPanel>
            </ToggleButton>

            <Button Grid.Column="4" VerticalAlignment="Center" Height="32" MinWidth="0" Padding="12,0"
                    Click="ToggleView_Click"
                    ToolTipService.ToolTip="切换卡片 / 表格视图">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.ViewGlyph, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ViewText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="RankingButton" Grid.Column="5" VerticalAlignment="Center"
                          Height="32" MinWidth="0" Padding="12,0"
                          IsChecked="{x:Bind ViewModel.IsRankingView, Mode=TwoWay}"
                          ToolTipService.ToolTip="流量排行：按主机/进程/来源聚合，点选下钻">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                    <TextBlock Text="排行" />
                </StackPanel>
            </ToggleButton>

            <Button Grid.Column="6" VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                    ToolTipService.ToolTip="表格列选择"
                    Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay}"
                    Click="Columns_Click">
                <FontIcon FontSize="12" Glyph="&#xE8FC;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="ColumnsFlyout" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutSubItem Text="显示列">
                            <ToggleMenuFlyoutItem x:Name="ColProcess" Text="进程" Tag="process" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColHost" Text="主机" Tag="host" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColNetwork" Text="网络" Tag="network" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColRule" Text="规则" Tag="rule" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColUpload" Text="上传" Tag="upload" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColDownload" Text="下载" Tag="download" Click="Column_Toggle" />
                            <ToggleMenuFlyoutItem x:Name="ColDuration" Text="时长" Tag="duration" Click="Column_Toggle" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="7" VerticalAlignment="Center" Height="32" MinWidth="0" Padding="12,0"
                    Command="{x:Bind ViewModel.CloseAllCommand}"
                    Content="全部关闭" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="36,0,36,0">
            <Border>
            <StackPanel Spacing="8" Margin="0,0,0,24" MaxWidth="{StaticResource PageContentMaxWidth}">

            <!-- 流量排行视图：维度切换 + 排行列表，点选下钻 -->
            <Grid Style="{StaticResource CardStyle}" Padding="16,12"
                  Visibility="{x:Bind ViewModel.IsRankingView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="流量排行" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" Height="32" MinWidth="0"
                                  SelectedIndex="{x:Bind ViewModel.RankingDimensionIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="按主机" />
                            <ComboBoxItem Content="按进程" />
                            <ComboBoxItem Content="按来源" />
                        </ComboBox>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.RankingHint, Mode=OneWay}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rankings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RankingRowViewModel">
                                <Button HorizontalContentAlignment="Stretch" Padding="8,5"
                                        Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource SelectedToBrush}}"
                                        Command="{Binding DataContext.SelectRankingCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Count}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource RateUpBrush}" Text="{x:Bind Up}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource RateDownBrush}" Text="{x:Bind Down}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 表格视图：表头 + 行，列可排序可开关 -->
            <Grid Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="process">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="进程" />
                                <FontIcon FontSize="8" Glyph="{x:Bind ViewModel.SortArrow('process'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="host">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="主机" />
                                <FontIcon FontSize="8" Glyph="{x:Bind ViewModel.SortArrow('host'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="network"
                                Visibility="{Binding Columns[2].IsVisible, ElementName=PageRoot}">
                            <TextBlock Text="网络" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="rule"
                                Visibility="{Binding Columns[3].IsVisible, ElementName=PageRoot}">
                            <TextBlock Text="规则" />
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="upload"
                                Visibility="{Binding Columns[4].IsVisible, ElementName=PageRoot}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="上传" />
                                <FontIcon FontSize="8" Glyph="{x:Bind ViewModel.SortArrow('upload'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="download"
                                Visibility="{Binding Columns[5].IsVisible, ElementName=PageRoot}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="下载" />
                                <FontIcon FontSize="8" Glyph="{x:Bind ViewModel.SortArrow('download'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}"
                                HorizontalContentAlignment="Left" Click="HeaderSort_Click" Tag="duration"
                                Visibility="{Binding Columns[6].IsVisible, ElementName=PageRoot}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="时长" />
                                <FontIcon FontSize="8" Glyph="{x:Bind ViewModel.SortArrow('duration'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}"
                          Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                        <Grid ColumnSpacing="12" Padding="12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Process}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Host}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Network}"
                                       Visibility="{Binding Columns[2].IsVisible, ElementName=PageRoot}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Rule}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Columns[3].IsVisible, ElementName=PageRoot}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource RateUpBrush}" Text="{x:Bind Upload}"
                                       Visibility="{Binding Columns[4].IsVisible, ElementName=PageRoot}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource RateDownBrush}" Text="{x:Bind Download}"
                                       Visibility="{Binding Columns[5].IsVisible, ElementName=PageRoot}" />
                            <TextBlock Grid.Column="6" Text="{x:Bind Duration}"
                                       Visibility="{Binding Columns[6].IsVisible, ElementName=PageRoot}" />
                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                        ToolTipService.ToolTip="详情" Tag="{x:Bind}" Click="Details_Click">
                                    <FontIcon FontSize="10" Glyph="&#xE8A7;" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                        ToolTipService.ToolTip="复制为规则" Tag="{x:Bind}" Click="CopyRule_Click">
                                    <FontIcon FontSize="10" Glyph="&#xE8C8;" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                                        ToolTipService.ToolTip="关闭此连接"
                                        Command="{Binding DataContext.CloseConnectionCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind}">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 卡片视图 -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}"
                          Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                        <Grid Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="36" Height="36"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Source="{x:Bind Icon}"
                                   Visibility="{x:Bind HasIcon, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Process}" />
                                    <Run Text=" → " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind Host}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid Style="{StaticResource TagChipStyle}">
                                        <TextBlock Text="{x:Bind Network}" />
                                    </Grid>
                                    <Grid Style="{StaticResource TagChipStyle}"
                                            Visibility="{x:Bind HasChain, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Chain}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource NodeNameFontFamily}" />
                                    </Grid>
                                    <Grid Style="{StaticResource TagChipStyle}"
                                            Visibility="{x:Bind HasRule, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Rule}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2" MinWidth="72" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Upload}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="{x:Bind UpRate, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="2" MinWidth="72" Margin="12,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Download}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           Text="{x:Bind DownRate, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Spacing="2" MinWidth="56" Margin="12,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="时长" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind Duration}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28"
                                        ToolTipService.ToolTip="详情"
                                        Tag="{x:Bind}"
                                        Click="Details_Click">
                                    <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28"
                                        ToolTipService.ToolTip="复制为规则"
                                        Tag="{x:Bind}"
                                        Click="CopyRule_Click">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28"
                                        ToolTipService.ToolTip="关闭此连接"
                                        Command="{Binding DataContext.CloseConnectionCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
